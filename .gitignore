# ---------------------------------------------------------------- 虚拟环境
# 384 MB，本机专用。别提交，用 setup.bat 重建（它会建 .venv 并装依赖）。
.venv/
venv/
env/

# ---------------------------------------------------------------- Python 缓存
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------- 截图与探测原始输出
# 这些是开发时抓的图 / 接口原始响应。**里面是本机桌面的画面**
# （含个人窗口内容、支付二维码等），不适合公开，一律不进仓库。
tools/*.png
tools/*.txt
tools/_*.json
tools/_raw/

# 大型数据不进仓库：ECDICT 词库（63 MB CSV + 53 MB SQLite）放在
# %LOCALAPPDATA%\ScreenTranslator\dict\，由程序自己下载构建。
*.sqlite3
*.csv

# ---------------------------------------------------------------- 编辑器 / 系统
.vscode/
.idea/
*.swp
*~
Thumbs.db
desktop.ini
*.log
